{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoryBuilder / LocalStoryChat Novel Package",
  "type": "object",
  "properties": {
    "story_format_version": {"type": "string"},
    "title": {"type": "string"},
    "version": {"type": "string"},
    "status": {"type": "string"},
    "premise": {"type": "string"},
    "locations": {
      "type": "object",
      "description": "A collection keyed by location name. Location names are the object keys; all location details are optional.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "description": "Legacy description text retained for compatibility."
          },
          {
            "type": "object",
            "properties": {
              "type": {"type": "string"},
              "description": {"type": "string"},
              "geography": {"type": "string"},
              "climate": {"type": "string"},
              "notable_details": {"type": "string"}
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "character_cards": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "A filename or legacy plain-text entry kept unchanged."
          },
          {
            "type": "object",
            "description": "A structured card. Only name is required; all other information is optional.",
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "role": {"type": "string"},
              "age": {"type": ["integer", "string"]},
              "gender": {"type": "string"},
              "pronouns": {"type": "string", "description": "Legacy compatibility field; retained in existing cards but no longer shown in the editor."},
              "relationship_status": {"type": "string"},
              "occupation": {"type": "string"},
              "status": {"type": "string"},
              "description": {"type": "string"},
              "background": {"type": "string"},
              "personality": {"type": "array", "items": {"type": "string"}},
              "hobbies": {"type": "array", "items": {"type": "string"}},
              "skills": {"type": "array", "items": {"type": "string"}},
              "strengths": {"type": "array", "items": {"type": "string"}},
              "weaknesses": {"type": "array", "items": {"type": "string"}},
              "goals": {"type": "array", "items": {"type": "string"}},
              "future_story_role": {"type": "array", "items": {"type": "string"}},
              "social": {"type": "array", "items": {"type": "string"}},
              "appearance": {
                "oneOf": [
                  {"type": "string"},
                  {
                    "type": "object",
                    "properties": {
                      "height": {"type": "string"},
                      "build": {"type": "string"},
                      "hair": {"type": "string"},
                      "eyes": {"type": "string"},
                      "style": {"type": "string"},
                      "notes": {"type": "string"}
                    },
                    "additionalProperties": true
                  }
                ]
              },
              "relationships": {
                "type": "object",
                "additionalProperties": true
              },
              "school": {
                "oneOf": [
                  {"type": "string"},
                  {
                    "type": "object",
                    "properties": {"performance": {"type": "string"}},
                    "additionalProperties": true
                  }
                ]
              }
            },
            "required": ["name"],
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "required": ["story_format_version", "title", "character_cards"]
}
